#include <iostream>
using namespace std;

string word(string str){
int count1=0;
int count2=0;

for(int i=0;i<str.length();i++){
    if(str[i]>='A' && str[i]<='Z'){
        count1++;
    }
    else if(str[i]>='a' && str[i]<='z'){
        count2++;
    }
}
for(int i=0;i<str.length();i++){
if(count1>count2){
    str[i] = toupper(str[i]);
}else if(count1<=count2){
    str[i] = tolower(str[i]);
}
}
return str;
}

int main() {
    string str;
    getline(cin, str);
    cout << word(str) << endl;
    return 0;
}
