#include <iostream>
#include <algorithm>
using namespace std;

string sortString(string str) {
    string digits;

    
    for (char ch : str) {
        if (isdigit(ch))
            digits += ch;
    }

   
    sort(digits.begin(), digits.end());

   
    string ans;
    for (int i = 0; i < digits.size(); i++) {
        ans += digits[i];
        if (i != digits.size() - 1)
            ans += '+';
    }

    return ans;
}

int main() {
    string str;
    cin >> str;

    cout << sortString(str);

    return 0;
}
